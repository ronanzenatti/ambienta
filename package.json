{
  "name": "ambienta",
  "version": "0.1.0",
  "private": true,
  "description": "Ambienta: front-end (Tailwind CSS v4, Alpine.js)",
  "scripts": {
    "build:theme": "node scripts/build-theme.js",
    "build:assets": "node scripts/copy-assets.js",
    "build:css": "tailwindcss -i resources/css/app.css -o public/assets/css/app.css --minify",
    "audit:a11y": "node scripts/axe.js",
    "build": "npm run build:theme && npm run build:assets && npm run build:css",
    "dev": "npm run build:theme && npm run build:assets && tailwindcss -i resources/css/app.css -o public/assets/css/app.css --watch"
  },
  "dependencies": {
    "@alpinejs/focus": "^3.17.4",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "alpinejs": "^3.17.4",
    "tailwindcss": "^4.3.3",
    "tom-select": "^2.6.2"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "puppeteer-core": "^25.12.0"
  }
}
