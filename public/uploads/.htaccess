# Arquivos enviados pelos cadastros (logo, foto, mapa): só imagens e PDFs, com nome aleatório gerado
# pelo sistema. Nada aqui pode ser executado nem listado.
Options -Indexes -ExecCGI

<FilesMatch "\.(?i:php[0-9]?|phtml|phar|phps|pl|py|cgi|sh|asp|aspx|jsp|htaccess)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
