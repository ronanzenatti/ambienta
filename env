#--------------------------------------------------------------------
# LOGIN COM GOOGLE WORKSPACE
#--------------------------------------------------------------------
# Credenciais OAuth 2.0 (tipo "Aplicativo da Web") criadas no Google Cloud Console.
# Sem clientId/clientSecret o botão do Google não aparece.
# A URI de redirecionamento autorizada deve ser: <app.baseURL>auth/google/callback
# (em desenvolvimento: http://localhost:8080/auth/google/callback).
# Nunca commite o .env com o segredo real.

# google.clientId =
# google.clientSecret =
# google.redirectUri =

